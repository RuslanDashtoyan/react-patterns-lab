# Copy this file to .env.local and paste your key after the "=".
#   cp .env.example .env.local
# Create a key in the Claude Console (https://platform.claude.com).
# Step-by-step guide: https://platform.claude.com/docs/en/get-api-key
#
# .env.local is git-ignored, and only server code can read it
# (variables without the NEXT_PUBLIC_ prefix never reach the browser).
ANTHROPIC_API_KEY=
